# ──────────────────────────────────────────────
# Janv Platform — Environment Configuration
# ──────────────────────────────────────────────

# Server
HOST=0.0.0.0
PORT=8080
RUST_LOG=janv_api=debug,tower_http=debug

# PostgreSQL
DATABASE_URL=postgres://janv:janv_secret@localhost:5433/janv_db
POSTGRES_USER=janv
POSTGRES_PASSWORD=janv_secret
POSTGRES_DB=janv_db
POSTGRES_PORT=5433

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string-in-production
JWT_ACCESS_TOKEN_EXPIRES_SECS=3600
JWT_REFRESH_TOKEN_EXPIRES_SECS=604800

# MinIO / S3
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=janv-assets

# Code Executor
EXECUTOR_MAX_CPU=0.5
EXECUTOR_MAX_MEMORY_MB=128
EXECUTOR_TIMEOUT_SECS=10
EXECUTOR_MAX_OUTPUT_BYTES=65536

# Super Admin (created on first run)
SUPER_ADMIN_EMAIL=admin@janv.dev
SUPER_ADMIN_PASSWORD=admin123
